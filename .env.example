# ==============================================================================
# Data Contracts & Semantic Platform — Environment Configuration
# Copy to .env and adjust values for local or containerized execution.
# ==============================================================================

PROJECT_NAME="Data Contracts & Semantic Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage & Contract Paths
WAREHOUSE_SQLITE_PATH=data/warehouse.db
QUARANTINE_DIR=data/quarantine
CONTRACTS_DIR=contracts
METRICS_YAML_PATH=semantic_layer/metrics.yml

# PostgreSQL Warehouse (Docker Compose defaults)
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics_dev_password
POSTGRES_DB=analytics_dw
POSTGRES_PORT=5432
POSTGRES_DSN=postgresql://analytics:analytics_dev_password@postgres:5432/analytics_dw

# Semantic API & Observability Ports
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_password

# Cloud Mirror / Alerting (Optional locally)
ALERT_WEBHOOK_URL=
AWS_REGION=us-east-1
